# Copy this file to .env and fill in real values. Never commit .env.

# Local MongoDB, or your MongoDB Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelflife?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shelflife

# Long random string used to sign login cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

PORT=3000
NODE_ENV=development
