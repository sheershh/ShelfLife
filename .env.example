# Copy this file to .env and fill in real values. Never commit .env (it is in .gitignore).

# Long random string used to sign login cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster, no card needed).
# Atlas -> your cluster -> Connect -> Drivers -> copy the "mongodb+srv://..." string,
# put your database user's password in it and add the database name "shelflife" before the "?":
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shelflife?retryWrites=true&w=majority
# If this is left empty in development, a temporary in-memory database is used instead (data is lost on restart).
MONGODB_URI=

# Google AI Studio API key for the freshness scanner (free tier; never enable billing).
# https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
# Gemini model used for the scanner and assistant. Must support image input.
GEMINI_MODEL=gemini-3.5-flash
