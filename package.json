{
  "name": "shelflife",
  "version": "1.0.0",
  "description": "ShelfLife: food freshness guide with an AI freshness scanner, accounts, saved foods and an admin console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node scripts/seed.js",
    "make-admin": "node scripts/make-admin.js",
    "migrate-users": "node scripts/migrate-users.js",
    "eval": "node scripts/evaluate-scanner.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
